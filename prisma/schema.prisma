// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  ATTENDEE
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  username  String   @unique
  email     String   @unique
  hash      String
  createdAt DateTime @default(now())
  role      UserRole
  afm       String   @unique
  area      String
  city      String
  country   String
  approved  Boolean  @default(false)

  organizedEvents Event[]
  bookings        Booking[]
  eventVisits     EventVisit[]
}

enum EventType {
  CONFERENCE
  WORKSHOP
  SEMINAR
  NETWORKING
  CONCERT
  EXHIBITION
  FESTIVAL
  GALA
  PARTY
  MEETUP
  WEBINAR
  SPORTS
  THEATER
  COMMUNITY
  FUNDRAISER
  OTHER
}

enum EventCategory {
  // Conference / Seminar / Workshop
  ACADEMIC
  TECH_IT
  SKILL_BUILDING
  PROFESSIONAL_DEVELOPMENT
  PANEL_DISCUSSION

  // Entertainment
  LIVE_MUSIC
  STAND_UP_COMEDY
  FILM_FESTIVAL
  FOOD_DRINK

  // Social / Community
  BUSINESS_MIXER
  VOLUNTEER_FAIR
  CHARITY_AUCTION

  // Sports
  TOURNAMENT
  FITNESS_CLASS
  ESPORTS

  // Generic
  GENERAL
  PRIVATE_EVENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REMOVED
}

model Event {
  id            String          @id @default(uuid())
  title         String
  description   String
  type          EventType
  categories    EventCategory[]
  venue         String
  address       String
  city          String
  country       String
  latitude      Float?
  longitude     Float?
  startDateTime DateTime
  endDateTime   DateTime
  capacity      Int
  status        EventStatus     @default(DRAFT)
  updatedAt     DateTime        @default(now()) @updatedAt
  ticketTypes   EventTickets[]
  media         String[]

  organizerId String
  organizer   User         @relation(fields: [organizerId], references: [id])
  eventVisits EventVisit[]
}

model EventTickets {
  id        Int    @id @default(autoincrement())
  name      String
  price     Float
  quantity  Int
  available Int

  eventId  String
  event    Event     @relation(fields: [eventId], references: [id])
  bookings Booking[]

  @@index([eventId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id              String        @id @default(uuid())
  time            DateTime      @default(now())
  status          BookingStatus @default(PENDING)
  numberOfTickets Int
  totalCost       Float

  ticketTypeId Int
  ticketType   EventTickets @relation(fields: [ticketTypeId], references: [id])

  attendeeId String
  attendee   User   @relation(fields: [attendeeId], references: [id])
}

model EventVisit {
  id        Int      @id @default(autoincrement())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  visitedAt DateTime @default(now())
}

model RecommendationModel {
  id          String   @id @default("global")
  globalMean  Float
  userBiases  Json
  itemBiases  Json
  userFactors Json
  itemFactors Json
  updatedAt   DateTime @updatedAt
}
